    - target: {fileID: 6734986186984793279, guid: 748fb18f1800d4b5cbb03adb203e00f3, type: 3}
      propertyPath: m_text
      value: "Une strat\xE9gie de lutte contre les inondations consiste \xE0 cr\xE9er
        des zones d\u2019expansion de crue, c\u2019est-\xE0-dire des espaces o\xF9
        l\u2019eau peut s\u2019\xE9tendre sans danger pour les personnes ni pour
        les biens.\n\nD\xE9tournez l'eau vers une zone sans habitation en construisant
        des digues et un barrage sur la rivi\xE8re !"
